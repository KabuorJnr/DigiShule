# Supabase connection for the EduOne frontend.
# Copy to .env and fill in your project's values (Settings -> API).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed locally to run scripts/seed.mjs (never ship this to the browser):
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email configuration
SMTP_USER=eduone.africa@gmail.com
SMTP_PASS=your-gmail-app-password

# Sentry error reporting (leave blank locally; set the DSN in prod).
# Get one at sentry.io -> Projects -> your project -> Client Keys.
VITE_SENTRY_DSN=
# Optional: pins releases in Sentry to a specific app version.
VITE_APP_VERSION=1.0.1

# ── AI (edge function secrets) ─────────────────────────────────────────
# EduOne's AI features (weekly brief, remarks, defaulter copilot) run in a
# Supabase Edge Function. The function picks the first key it finds:
#   1. Per-school row in `school_ai_credentials` (set in Settings → AI).
#   2. OPENAI_API_KEY  or  OPENAI_KEY  (auto-aliased)
#   3. ANTHROPIC_API_KEY
# Set the one you have and run:  npm run sync-secrets
# to push it to the Supabase project as an Edge Function secret.
OPENAI_KEY=
# ANTHROPIC_API_KEY=
# Needed by sync-secrets to know which project to push to:
SUPABASE_PROJECT_REF=
