{
  "name": "digischool",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=4096 eslint .",
    "sync-secrets": "node scripts/sync-supabase-secrets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "mobile:build": "vite build && cap sync",
    "mobile:sync": "cap sync",
    "mobile:assets": "capacitor-assets generate --iconBackgroundColor #0f172a --iconBackgroundColorDark #0f172a --splashBackgroundColor #0f172a --splashBackgroundColorDark #0f172a",
    "android:open": "cap open android",
    "android:run": "vite build && cap sync android && cap run android",
    "android:bundle": "vite build && cap sync android && cd android && gradlew.bat bundleRelease",
    "ios:open": "cap open ios",
    "ios:run": "vite build && cap sync ios && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/inter": "^5.3.0",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.108.0",
    "@tanstack/react-query": "^5.101.2",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.20.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "posthog-js": "^1.416.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.6",
    "react-jss": "^10.10.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.8.1",
    "resend": "^6.17.1",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.20",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
