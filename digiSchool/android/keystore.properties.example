# Copy this file to `keystore.properties` (same folder) and fill in your values.
# `keystore.properties` and the .jks file are git-ignored — never commit them.
# Back up the .jks file + these passwords somewhere safe: they are your app's
# upload key. (With Play App Signing you can reset a lost upload key, but keep it.)

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
