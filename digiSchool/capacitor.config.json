{
  "appId": "com.eduone.app",
  "appName": "EduOne",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "backgroundColor": "#0B1B3E",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": false,
      "backgroundColor": "#0B1B3E",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "Keyboard": {
      "resize": "native"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B1B3E",
      "overlaysWebView": false
    }
  }
}
